{
  "name": "midwest-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src && next lint",
    "lint:fix": "biome check --write src && next lint --fix",
    "format": "biome format --write src",
    "compile-importer": "tsc -p tsconfig-import-shapefiles.json",
    "import-shapefiles": "node out-scripts/src/script/ImportShapefiles.js clusters-2025.shp",
    "import-counties": "node out-scripts/src/script/ImportCounties.js",
    "merge-timeline": "node out-scripts/src/script/MergeAdvancementData.js",
    "map-counties": "node out-scripts/src/script/MapCountiesToClusters.js",
    "merge-groupings": "node out-scripts/src/script/MergeGroupings.js",
    "prepare-data": "pnpm compile-importer && pnpm import-shapefiles && pnpm import-counties && pnpm merge-timeline && pnpm merge-groupings && pnpm map-counties && biome format --write src/data/clusterCounties.ts"
  },
  "dependencies": {
    "@loaders.gl/core": "^4.5.1",
    "@loaders.gl/loader-utils": "^4.5.1",
    "@loaders.gl/shapefile": "^4.5.1",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/point-on-feature": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-equals": "^6.0.3",
    "lucide-react": "^0.577.0",
    "mapbox-gl": "^3.31.0",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "seedrandom": "^3.0.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-extras": "^0.17.0",
    "zod": "^4.6.5",
    "zod-geojson": "^1.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/seedrandom": "^3.0.8",
    "csv-parse": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "type-fest": "^5.10.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
